<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20250427181600-1" author="VinhNguyenD23">
        <createTable tableName="file_attachment" schemaName="content">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="content_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_file_attachment_content"
                             referencedTableName="team_contents"
                             referencedTableSchemaName="content"
                             referencedColumnNames="id"/>
            </column>
            <column name="url" type="text">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
